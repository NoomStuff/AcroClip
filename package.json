{
   "name": "acroclip",
   "version": "0.3.2",
   "description": "Clip it. Watch it. Share It.",
   "license": "GPL-3.0-or-later",
   "type": "module",
   "main": "out/main/index.js",
   "desktopName": "dev.acroclip.app.desktop",
   "author": "NoomStuff",
   "scripts": {
      "dev": "install-electron && bun run build:icons && bun scripts/dev.ts",
      "build": "bun run build:icons && bun run typecheck && electron-vite build",
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "format": "prettier --write src scripts tests docs .github .vscode \"*.{ts,mjs,json,md}\" .prettierrc.json",
      "format:check": "prettier --check src scripts tests docs .github .vscode \"*.{ts,mjs,json,md}\" .prettierrc.json",
      "lint": "eslint src scripts tests \"*.{ts,mjs}\" --max-warnings 0",
      "verify": "bun run format:check && bun run lint && bun run test && bun run build",
      "verify:release": "bun run verify && bun run test:media && bun run test:ui && bun run test:ui:native && bun run test:capture-loss && bun run test:packaged",
      "test:ui": "bun scripts/run-interactive-tests.ts ui",
      "test:ui:native": "bun scripts/run-interactive-tests.ts ui-native",
      "test:isolated": "bun scripts/run-interactive-tests.ts",
      "test:media": "bun tests/media.ts",
      "test:packaged": "bun scripts/run-interactive-tests.ts packaged",
      "test:packaged:linux": "python3 scripts/test-linux-packaged.py",
      "test:native": "bun scripts/run-interactive-tests.ts native",
      "test:native:lifecycle": "bun scripts/run-interactive-tests.ts lifecycle",
      "test:capture-loss": "bun scripts/run-interactive-tests.ts capture-loss",
      "test:fullscreen": "bun scripts/run-interactive-tests.ts fullscreen",
      "build:icons": "bun scripts/build-icons.ts",
      "build:notices": "bun scripts/generate-notices.ts",
      "bundle:media": "bun scripts/bundle-media.ts",
      "build:native": "bun scripts/build-native.ts",
      "dist": "bun scripts/package.ts dist",
      "package": "bun scripts/package.ts dir",
      "test:portable": "bun scripts/run-interactive-tests.ts portable",
      "release:downloads": "bun scripts/release-downloads.ts",
      "release:feeds": "bun scripts/prepare-update-feed.ts"
   },
   "build": {
      "appId": "dev.acroclip.app",
      "productName": "AcroClip",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "directories": {
         "output": "release"
      },
      "files": [
         "out/**/*",
         "package.json"
      ],
      "extraResources": [
         {
            "from": "resources/media",
            "to": "media"
         },
         {
            "from": "resources/recorder",
            "to": "recorder"
         },
         {
            "from": "resources/notices",
            "to": "notices"
         },
         {
            "from": "LICENSE",
            "to": "LICENSE"
         },
         {
            "from": "THIRD_PARTY_NOTICES.md",
            "to": "THIRD_PARTY_NOTICES.md"
         },
         {
            "to": "icons/icon.png",
            "from": "build/icon.png"
         },
         {
            "to": "icons/icon.ico",
            "from": "build/icon.ico"
         },
         {
            "to": "LICENSE-AttaCut",
            "from": "licenses/AttaCut-MIT.txt"
         }
      ],
      "win": {
         "icon": "build/icon.ico",
         "target": [
            "nsis",
            "portable"
         ],
         "signExecutable": false
      },
      "nsis": {
         "oneClick": false,
         "allowToChangeInstallationDirectory": true,
         "artifactName": "${productName}-${version}-${os}-${arch}-Installer.${ext}",
         "include": "build/installer.nsh"
      },
      "mac": {
         "icon": "build/icon.icns",
         "target": [
            "dmg",
            "zip"
         ],
         "category": "public.app-category.video",
         "extendInfo": {
            "NSMicrophoneUsageDescription": "Record your microphone in clips when you enable it.",
            "NSScreenCaptureUsageDescription": "Capture the screen or application you select."
         }
      },
      "linux": {
         "icon": "build/icon.png",
         "syncDesktopName": true,
         "target": [
            "AppImage"
         ],
         "category": "AudioVideo"
      },
      "publish": [
         {
            "provider": "github",
            "owner": "NoomStuff",
            "repo": "AcroClip"
         }
      ]
   },
   "dependencies": {
      "electron-updater": "^6.7.3",
      "lucide-react": "^1.52.0",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "zod": "^4.6.5"
   },
   "devDependencies": {
      "@eslint/js": "^10.0.1",
      "@playwright/test": "^1.63.0",
      "@swc/core": "^1.16.13",
      "@types/node": "^26.6.2",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/semver": "^7.8.0",
      "@vitejs/plugin-react": "^5.2.0",
      "electron": "^44.4.5",
      "electron-builder": "^26.15.3",
      "electron-vite": "^5.0.0",
      "eslint": "^10.11.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "png-to-ico": "^3.0.2",
      "prettier": "^3.9.9",
      "sharp": "^0.35.4",
      "typescript": "~6.0.3",
      "typescript-eslint": "^8.70.1",
      "vite": "^7.3.6",
      "vitest": "^5.0.1"
   }
}
