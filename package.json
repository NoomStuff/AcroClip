{
   "name": "acroclip",
   "version": "0.24.0",
   "description": "Clip it. Watch it. Share It.",
   "license": "GPL-3.0-or-later",
   "type": "module",
   "main": "out/main/index.js",
   "desktopName": "dev.acroclip.app.desktop",
   "author": "NoomStuff",
   "scripts": {
      "dev": "install-electron && bun run build:icons && bun scripts/dev.ts",
      "build": "bun run build:icons && bun run typecheck && electron-vite build",
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "format": "prettier --write src scripts tests .github .vscode \"*.{ts,mjs,json,md}\" .prettierrc.json",
      "format:check": "prettier --check src scripts tests .github .vscode \"*.{ts,mjs,json,md}\" .prettierrc.json",
      "lint": "eslint src scripts tests \"*.{ts,mjs}\" --max-warnings 0",
      "verify": "bun run format:check && bun run lint && bun run test && bun run build",
      "verify:release": "bun run verify && bun run test:media && bun run test:ui && bun run test:ui:native && bun run test:capture-loss && bun run test:packaged && bun run test:update",
      "test:ui": "bun scripts/run-interactive-tests.ts ui",
      "test:ui:native": "bun scripts/run-interactive-tests.ts ui-native",
      "test:isolated": "bun scripts/run-interactive-tests.ts",
      "test:media": "bun tests/media.ts",
      "test:packaged": "bun scripts/run-interactive-tests.ts packaged",
      "test:update": "bun scripts/run-interactive-tests.ts update",
      "test:packaged:linux": "python3 scripts/test-linux-packaged.py",
      "test:native": "bun scripts/run-interactive-tests.ts native",
      "test:native:lifecycle": "bun scripts/run-interactive-tests.ts lifecycle",
      "test:capture-loss": "bun scripts/run-interactive-tests.ts capture-loss",
      "test:fullscreen": "bun scripts/run-interactive-tests.ts fullscreen",
      "build:icons": "bun scripts/build-icons.ts",
      "build:notices": "bun scripts/generate-notices.ts",
      "bundle:media": "bun scripts/bundle-media.ts",
      "build:native": "bun scripts/build-native.ts",
      "dist": "bun scripts/package.ts dist",
      "package": "bun scripts/package.ts dir",
      "release": "bun scripts/release.ts",
      "test:portable": "bun scripts/run-interactive-tests.ts portable",
      "test:ui:linux": "python3 scripts/run-linux-ui.py bun run test:ui",
      "test:ui:native:linux": "ACROCLIP_NATIVE_UI=1 python3 scripts/run-linux-ui.py bun x playwright test linux-native linux-desktop"
   },
   "build": {
      "appId": "dev.acroclip.app",
      "productName": "AcroClip",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
      "directories": {
         "output": "release"
      },
      "files": [
         "out/**/*",
         "package.json"
      ],
      "extraResources": [
         {
            "from": "resources/feedback",
            "to": "feedback"
         },
         {
            "from": "resources/media",
            "to": "media"
         },
         {
            "from": "resources/recorder",
            "to": "recorder"
         },
         {
            "from": "resources/notices",
            "to": "notices"
         },
         {
            "from": "LICENSE",
            "to": "LICENSE"
         },
         {
            "from": "THIRD_PARTY_NOTICES.md",
            "to": "THIRD_PARTY_NOTICES.md"
         },
         {
            "to": "icons/icon.png",
            "from": "build/icon.png"
         },
         {
            "to": "icons/icon.ico",
            "from": "build/icon.ico"
         }
      ],
      "win": {
         "icon": "build/icon.ico",
         "target": [
            "nsis",
            "portable"
         ],
         "signExecutable": false
      },
      "nsis": {
         "installerIcon": "build/icon.ico",
         "uninstallerIcon": "build/icon.ico",
         "installerHeaderIcon": "build/icon.ico",
         "installerSidebar": "build/installerSidebar.bmp",
         "uninstallerSidebar": "build/installerSidebar.bmp",
         "oneClick": false,
         "allowToChangeInstallationDirectory": true,
         "artifactName": "${productName}-${version}-${os}-${arch}-Installer.${ext}",
         "include": "build/installer.nsh"
      },
      "portable": {
         "splashImage": "build/portableSplash.bmp"
      },
      "mac": {
         "icon": "build/icon.icns",
         "target": [
            "dmg",
            "zip"
         ],
         "category": "public.app-category.video",
         "extendInfo": {
            "NSMicrophoneUsageDescription": "Record your microphone in clips when you enable it.",
            "NSScreenCaptureUsageDescription": "Capture the screen or application you select."
         }
      },
      "linux": {
         "icon": "build/icon.png",
         "syncDesktopName": true,
         "target": [
            "AppImage"
         ],
         "category": "AudioVideo"
      },
      "publish": [
         {
            "provider": "github",
            "owner": "NoomStuff",
            "repo": "AcroClip"
         }
      ]
   },
   "dependencies": {
      "electron-updater": "^6.8.11",
      "lucide-react": "^1.72.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "zod": "^4.6.7"
   },
   "devDependencies": {
      "@electron/asar": "3.4.1",
      "@eslint/js": "^10.0.1",
      "@playwright/test": "^1.65.0",
      "@swc/core": "^1.16.22",
      "@types/node": "^26.6.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@types/semver": "^7.8.0",
      "@vitejs/plugin-react": "^5.2.0",
      "electron": "^44.7.0",
      "electron-builder": "^26.18.0",
      "electron-vite": "^5.0.0",
      "eslint": "^10.14.0",
      "eslint-plugin-react-hooks": "^7.1.1",
      "png-to-ico": "^3.0.2",
      "prettier": "^3.10.0",
      "sharp": "^0.35.5",
      "typescript": "~6.0.3",
      "typescript-eslint": "^8.72.2",
      "vite": "^7.3.8",
      "vitest": "5.0.3"
   }
}
