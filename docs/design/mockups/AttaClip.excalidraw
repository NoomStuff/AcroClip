      "text": "Energetic",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "p95PX1chV2corXYrVbyqR",
      "originalText": "Energetic",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "18Ujx8f-Zv1oeCGY09I0e",
      "type": "text",
      "x": -429.99835432321015,
      "y": -4439.087967427057,
      "width": 665.739501953125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 1917767990,
      "version": 1046,
      "versionNonce": 13030617,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787147673249,
      "link": null,
      "locked": false,
      "text": "For people who want a companion that doesn't distract them\n- Pet doesn't move around on it's own\n- Only play sounds when interacting with the pet\n- Pet doesn't distract you\n- No item spawning\n- Pet doesn't collide with windows\n- Optimises the game to take away as little performance as possible\n\nYou can change these at any time using the options menu",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For people who want a companion that doesn't distract them\n- Pet doesn't move around on it's own\n- Only play sounds when interacting with the pet\n- Pet doesn't distract you\n- No item spawning\n- Pet doesn't collide with windows\n- Optimises the game to take away as little performance as possible\n\nYou can change these at any time using the options menu",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "tfRIQvGEuGwOhq3j5qiCK",
      "type": "text",
      "x": -427.5214013889681,
      "y": -4104.952712409442,
      "width": 559.359619140625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 82005110,
      "version": 1200,
      "versionNonce": 581489081,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787147673249,
      "link": null,
      "locked": false,
      "text": "The intended experience\n- \n\nYou can change these at any time using the options menu",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The intended experience\n- \n\nYou can change these at any time using the options menu",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "OvmsG0Wqvd2aejbhTrTps",
      "type": "text",
      "x": -424.519482009744,
      "y": -3889.54210463542,
      "width": 559.359619140625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "cross-hatch",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 861108534,
      "version": 1548,
      "versionNonce": 888681113,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787147673249,
      "link": null,
      "locked": false,
      "text": "For people who want the to interact with their pet a lot\n- Spawns more items\n- Plays ambient music\n- Also collide with window sides\n- Optimises the game for quality\n- Enables run on startup\n\nYou can change these at any time using the options menu",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For people who want the to interact with their pet a lot\n- Spawns more items\n- Plays ambient music\n- Also collide with window sides\n- Optimises the game for quality\n- Enables run on startup\n\nYou can change these at any time using the options menu",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
