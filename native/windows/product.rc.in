#include <windows.h>
1 ICON "@ACROCLIP_RESOURCE_ICON@"
1 VERSIONINFO
 FILEVERSION @ACROCLIP_RESOURCE_VERSION@
 PRODUCTVERSION @ACROCLIP_RESOURCE_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "NoomStuff\0"
   VALUE "FileDescription", "@ACROCLIP_RESOURCE_DESCRIPTION@\0"
   VALUE "FileVersion", "@ACROCLIP_VERSION@\0"
   VALUE "InternalName", "@ACROCLIP_RESOURCE_FILENAME@\0"
   VALUE "OriginalFilename", "@ACROCLIP_RESOURCE_FILENAME@\0"
   VALUE "ProductName", "AcroClip\0"
   VALUE "ProductVersion", "@ACROCLIP_VERSION@\0"
   VALUE "LegalCopyright", "Copyright NoomStuff\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
